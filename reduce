import java.util.Arrays;
import java.util.List;
public class Main {
    public static void main(String[] args) {
        List<Integer> salaries = Arrays.asList(10000, 20000, 50000);
        double total = salaries.stream()
                .reduce( 0.0, (sum, salary) -> sum + (salary * 1.10), Double::sum );
        System.out.println("Total Salary after 10% increment: " + total);
    }
}
